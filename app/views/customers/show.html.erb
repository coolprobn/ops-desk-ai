<% content_for :title, "#{@customer.company} · Ops Desk" %>

<div class="flex items-start justify-between gap-4">
  <div>
    <p class="text-xs uppercase tracking-wider text-zinc-500">Customer</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-50"><%= @customer.company %></h1>
    <p class="mt-1 text-sm text-zinc-400"><%= @customer.name %> · <%= @customer.email %></p>
  </div>
  <div class="text-right text-sm">
    <p class="capitalize text-zinc-300"><%= @customer.status %></p>
    <p class="text-zinc-500"><%= @customer.plan || "No active plan" %></p>
  </div>
</div>

<section class="mt-10">
  <h2 class="text-sm font-medium uppercase tracking-wider text-zinc-400">Subscriptions</h2>
  <div class="mt-3 overflow-hidden rounded-lg border border-zinc-800">
    <table class="min-w-full text-sm">
      <thead class="bg-zinc-900/80 text-left text-xs uppercase tracking-wider text-zinc-500">
        <tr>
          <th class="px-4 py-3 font-medium">Plan</th>
          <th class="px-4 py-3 font-medium">Price</th>
          <th class="px-4 py-3 font-medium">Status</th>
          <th class="px-4 py-3 font-medium">Started</th>
          <th class="px-4 py-3 font-medium">Renewal</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-800">
        <% @subscriptions.each do |subscription| %>
          <tr class="hover:bg-zinc-900/50">
            <td class="px-4 py-3"><%= link_to subscription.plan_name, subscription_path(subscription), class: "text-zinc-100 hover:text-white" %></td>
            <td class="px-4 py-3 tabular-nums text-zinc-300"><%= number_to_currency(subscription.monthly_price_cents / 100.0) %></td>
            <td class="px-4 py-3 capitalize text-zinc-400"><%= subscription.status %></td>
            <td class="px-4 py-3 text-zinc-400"><%= l(subscription.started_at, format: :short) %></td>
            <td class="px-4 py-3 text-zinc-400"><%= l(subscription.renewal_at, format: :short) %></td>
          </tr>
        <% end %>
        <% if @subscriptions.empty? %>
          <tr><td colspan="5" class="px-4 py-6 text-zinc-500">No subscriptions.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="mt-10">
  <h2 class="text-sm font-medium uppercase tracking-wider text-zinc-400">Invoices</h2>
  <div class="mt-3 overflow-hidden rounded-lg border border-zinc-800">
    <table class="min-w-full text-sm">
      <thead class="bg-zinc-900/80 text-left text-xs uppercase tracking-wider text-zinc-500">
        <tr>
          <th class="px-4 py-3 font-medium">Issued</th>
          <th class="px-4 py-3 font-medium">Amount</th>
          <th class="px-4 py-3 font-medium">Status</th>
          <th class="px-4 py-3 font-medium">Paid</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-800">
        <% @invoices.each do |invoice| %>
          <tr class="hover:bg-zinc-900/50">
            <td class="px-4 py-3"><%= link_to l(invoice.issued_at, format: :short), invoice_path(invoice), class: "text-zinc-100 hover:text-white" %></td>
            <td class="px-4 py-3 tabular-nums text-zinc-300"><%= number_to_currency(invoice.amount_cents / 100.0) %></td>
            <td class="px-4 py-3 capitalize text-zinc-400"><%= invoice.status %></td>
            <td class="px-4 py-3 text-zinc-400"><%= invoice.paid_at ? l(invoice.paid_at, format: :short) : "—" %></td>
          </tr>
        <% end %>
        <% if @invoices.empty? %>
          <tr><td colspan="4" class="px-4 py-6 text-zinc-500">No invoices.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="mt-10">
  <h2 class="text-sm font-medium uppercase tracking-wider text-zinc-400">Support cases</h2>
  <div class="mt-3 overflow-hidden rounded-lg border border-zinc-800">
    <table class="min-w-full text-sm">
      <thead class="bg-zinc-900/80 text-left text-xs uppercase tracking-wider text-zinc-500">
        <tr>
          <th class="px-4 py-3 font-medium">Subject</th>
          <th class="px-4 py-3 font-medium">Priority</th>
          <th class="px-4 py-3 font-medium">Status</th>
          <th class="px-4 py-3 font-medium">Opened</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-800">
        <% @support_cases.each do |support_case| %>
          <tr class="hover:bg-zinc-900/50">
            <td class="px-4 py-3"><%= link_to support_case.subject, support_case_path(support_case), class: "text-zinc-100 hover:text-white" %></td>
            <td class="px-4 py-3 capitalize text-zinc-400"><%= support_case.priority %></td>
            <td class="px-4 py-3 capitalize text-zinc-400"><%= support_case.status %></td>
            <td class="px-4 py-3 text-zinc-400"><%= l(support_case.opened_at, format: :short) %></td>
          </tr>
        <% end %>
        <% if @support_cases.empty? %>
          <tr><td colspan="4" class="px-4 py-6 text-zinc-500">No cases.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
