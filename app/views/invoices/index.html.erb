<% content_for :title, "Invoices · Ops Desk" %>

<div class="flex items-baseline justify-between">
  <h1 class="text-2xl font-semibold tracking-tight text-zinc-50">Invoices</h1>
  <p class="text-sm text-zinc-500"><%= @invoices.size %></p>
</div>

<div class="mt-6 overflow-hidden rounded-lg border border-zinc-800">
  <table class="min-w-full text-sm">
    <thead class="bg-zinc-900/80 text-left text-xs uppercase tracking-wider text-zinc-500">
      <tr>
        <th class="px-4 py-3 font-medium">Customer</th>
        <th class="px-4 py-3 font-medium">Issued</th>
        <th class="px-4 py-3 font-medium">Amount</th>
        <th class="px-4 py-3 font-medium">Status</th>
        <th class="px-4 py-3 font-medium">Paid</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-zinc-800">
      <% @invoices.each do |invoice| %>
        <tr class="hover:bg-zinc-900/50">
          <td class="px-4 py-3"><%= link_to invoice.customer.company, customer_path(invoice.customer), class: "text-zinc-100 hover:text-white" %></td>
          <td class="px-4 py-3"><%= link_to l(invoice.issued_at, format: :short), invoice_path(invoice), class: "text-zinc-300 hover:text-white" %></td>
          <td class="px-4 py-3 tabular-nums text-zinc-300"><%= number_to_currency(invoice.amount_cents / 100.0) %></td>
          <td class="px-4 py-3 capitalize text-zinc-400"><%= invoice.status %></td>
          <td class="px-4 py-3 text-zinc-400"><%= invoice.paid_at ? l(invoice.paid_at, format: :short) : "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
