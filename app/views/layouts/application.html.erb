<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Ops Desk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Ops Desk">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-full bg-zinc-950 text-zinc-100 antialiased">
    <% if authenticated? %>
      <div class="flex min-h-screen">
        <aside class="flex w-56 shrink-0 flex-col border-r border-zinc-800 bg-zinc-950">
          <div class="border-b border-zinc-800 px-4 py-5">
            <p class="text-xs font-medium uppercase tracking-wider text-zinc-500">Ops Desk</p>
            <% organizations = current_user.organizations.order(:name) %>
            <% if organizations.many? %>
              <%= form_with url: current_organization_path, method: :patch, class: "mt-2" do %>
                <%= select_tag :organization_id,
                      options_from_collection_for_select(organizations, :id, :name, current_organization.id),
                      class: "w-full rounded-md border border-zinc-800 bg-zinc-900 px-2 py-1 text-sm text-zinc-100",
                      onchange: "this.form.requestSubmit()" %>
              <% end %>
            <% else %>
              <p class="mt-1 truncate text-sm font-semibold text-zinc-100"><%= current_organization.name %></p>
            <% end %>
          </div>

          <nav class="flex flex-1 flex-col gap-1 px-3 py-4">
            <%= nav_link_to "Dashboard", root_path %>
            <%= nav_link_to "Customers", customers_path %>
            <%= nav_link_to "Cases", support_cases_path %>
            <%= nav_link_to "Invoices", invoices_path %>
            <%= nav_link_to "Subscriptions", subscriptions_path %>
            <%= nav_link_to "Knowledge", knowledge_documents_path %>
          </nav>

          <div class="border-t border-zinc-800 px-4 py-4">
            <p class="truncate text-sm text-zinc-200"><%= current_user.name %></p>
            <p class="truncate text-xs text-zinc-500"><%= current_user.email_address %></p>
            <%= button_to "Sign out", session_path, method: :delete, class: "mt-3 text-xs font-medium text-zinc-400 hover:text-zinc-100 cursor-pointer" %>
          </div>
        </aside>

        <main class="flex-1 overflow-auto">
          <div class="mx-auto max-w-6xl px-6 py-8">
            <% if alert = flash[:alert] %>
              <p class="mb-4 rounded-md border border-red-900/60 bg-red-950/50 px-3 py-2 text-sm text-red-300" id="alert"><%= alert %></p>
            <% end %>
            <% if notice = flash[:notice] %>
              <p class="mb-4 rounded-md border border-emerald-900/60 bg-emerald-950/50 px-3 py-2 text-sm text-emerald-300" id="notice"><%= notice %></p>
            <% end %>
            <%= yield %>
          </div>
        </main>
      </div>
    <% else %>
      <main class="flex min-h-screen items-center justify-center px-4">
        <div class="w-full max-w-md">
          <% if alert = flash[:alert] %>
            <p class="mb-4 rounded-md border border-red-900/60 bg-red-950/50 px-3 py-2 text-sm text-red-300" id="alert"><%= alert %></p>
          <% end %>
          <% if notice = flash[:notice] %>
            <p class="mb-4 rounded-md border border-emerald-900/60 bg-emerald-950/50 px-3 py-2 text-sm text-emerald-300" id="notice"><%= notice %></p>
          <% end %>
          <%= yield %>
        </div>
      </main>
    <% end %>
  </body>
</html>
