<% content_for :title, "Cases · Ops Desk" %>

<div class="flex items-baseline justify-between">
  <h1 class="text-2xl font-semibold tracking-tight text-zinc-50">Support cases</h1>
  <p class="text-sm text-zinc-500"><%= @support_cases.size %></p>
</div>

<div class="mt-6 overflow-hidden rounded-lg border border-zinc-800">
  <table class="min-w-full text-sm">
    <thead class="bg-zinc-900/80 text-left text-xs uppercase tracking-wider text-zinc-500">
      <tr>
        <th class="px-4 py-3 font-medium">Subject</th>
        <th class="px-4 py-3 font-medium">Customer</th>
        <th class="px-4 py-3 font-medium">Priority</th>
        <th class="px-4 py-3 font-medium">Status</th>
        <th class="px-4 py-3 font-medium">Opened</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-zinc-800">
      <% @support_cases.each do |support_case| %>
        <tr class="hover:bg-zinc-900/50">
          <td class="px-4 py-3"><%= link_to support_case.subject, support_case_path(support_case), class: "font-medium text-zinc-100 hover:text-white" %></td>
          <td class="px-4 py-3"><%= link_to support_case.customer.company, customer_path(support_case.customer), class: "text-zinc-400 hover:text-zinc-200" %></td>
          <td class="px-4 py-3 capitalize text-zinc-400"><%= support_case.priority %></td>
          <td class="px-4 py-3 capitalize text-zinc-400"><%= support_case.status %></td>
          <td class="px-4 py-3 text-zinc-400"><%= l(support_case.opened_at, format: :short) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
