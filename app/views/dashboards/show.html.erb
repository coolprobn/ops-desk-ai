<% content_for :title, "Dashboard · Ops Desk" %>

<div class="flex items-baseline justify-between gap-4">
  <h1 class="text-2xl font-semibold tracking-tight text-zinc-50">Dashboard</h1>
  <p class="text-sm text-zinc-500"><%= current_organization.name %></p>
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="rounded-lg border border-zinc-800 bg-zinc-900/40 px-4 py-4">
    <p class="text-xs uppercase tracking-wider text-zinc-500">Customers</p>
    <p class="mt-2 text-3xl font-semibold tabular-nums text-zinc-50"><%= @customer_count %></p>
  </div>
  <div class="rounded-lg border border-zinc-800 bg-zinc-900/40 px-4 py-4">
    <p class="text-xs uppercase tracking-wider text-zinc-500">Open cases</p>
    <p class="mt-2 text-3xl font-semibold tabular-nums text-zinc-50"><%= @open_cases_count %></p>
  </div>
  <div class="rounded-lg border border-zinc-800 bg-zinc-900/40 px-4 py-4">
    <p class="text-xs uppercase tracking-wider text-zinc-500">Past due subs</p>
    <p class="mt-2 text-3xl font-semibold tabular-nums text-amber-300"><%= @past_due_subscriptions_count %></p>
  </div>
  <div class="rounded-lg border border-zinc-800 bg-zinc-900/40 px-4 py-4">
    <p class="text-xs uppercase tracking-wider text-zinc-500">Unpaid invoices</p>
    <p class="mt-2 text-3xl font-semibold tabular-nums text-amber-300"><%= @unpaid_invoices_count %></p>
  </div>
</div>

<div class="mt-10 grid gap-8 lg:grid-cols-2">
  <section>
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-sm font-medium uppercase tracking-wider text-zinc-400">Recent cases</h2>
      <%= link_to "View all", support_cases_path, class: "text-xs text-zinc-500 hover:text-zinc-300" %>
    </div>
    <ul class="divide-y divide-zinc-800 rounded-lg border border-zinc-800">
      <% @recent_cases.each do |support_case| %>
        <li>
          <%= link_to support_case_path(support_case), class: "block px-4 py-3 hover:bg-zinc-900/60" do %>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-sm font-medium text-zinc-100"><%= support_case.subject %></p>
                <p class="mt-0.5 text-xs text-zinc-500"><%= support_case.customer.company %></p>
              </div>
              <span class="shrink-0 text-xs capitalize text-zinc-400"><%= support_case.status %></span>
            </div>
          <% end %>
        </li>
      <% end %>
      <% if @recent_cases.empty? %>
        <li class="px-4 py-6 text-sm text-zinc-500">No cases yet.</li>
      <% end %>
    </ul>
  </section>

  <section>
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-sm font-medium uppercase tracking-wider text-zinc-400">Customers</h2>
      <%= link_to "View all", customers_path, class: "text-xs text-zinc-500 hover:text-zinc-300" %>
    </div>
    <ul class="divide-y divide-zinc-800 rounded-lg border border-zinc-800">
      <% @customers.each do |customer| %>
        <li>
          <%= link_to customer_path(customer), class: "block px-4 py-3 hover:bg-zinc-900/60" do %>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-sm font-medium text-zinc-100"><%= customer.company %></p>
                <p class="mt-0.5 text-xs text-zinc-500"><%= customer.name %></p>
              </div>
              <span class="shrink-0 text-xs capitalize text-zinc-400"><%= customer.status %></span>
            </div>
          <% end %>
        </li>
      <% end %>
      <% if @customers.empty? %>
        <li class="px-4 py-6 text-sm text-zinc-500">No customers yet.</li>
      <% end %>
    </ul>
  </section>
</div>
