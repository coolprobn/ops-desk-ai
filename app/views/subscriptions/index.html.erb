<% content_for :title, "Subscriptions · Ops Desk" %>

<div class="flex items-baseline justify-between">
  <h1 class="text-2xl font-semibold tracking-tight text-zinc-50">Subscriptions</h1>
  <p class="text-sm text-zinc-500"><%= @subscriptions.size %></p>
</div>

<div class="mt-6 overflow-hidden rounded-lg border border-zinc-800">
  <table class="min-w-full text-sm">
    <thead class="bg-zinc-900/80 text-left text-xs uppercase tracking-wider text-zinc-500">
      <tr>
        <th class="px-4 py-3 font-medium">Customer</th>
        <th class="px-4 py-3 font-medium">Plan</th>
        <th class="px-4 py-3 font-medium">Price</th>
        <th class="px-4 py-3 font-medium">Status</th>
        <th class="px-4 py-3 font-medium">Renewal</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-zinc-800">
      <% @subscriptions.each do |subscription| %>
        <tr class="hover:bg-zinc-900/50">
          <td class="px-4 py-3"><%= link_to subscription.customer.company, customer_path(subscription.customer), class: "text-zinc-100 hover:text-white" %></td>
          <td class="px-4 py-3"><%= link_to subscription.plan_name, subscription_path(subscription), class: "text-zinc-300 hover:text-white" %></td>
          <td class="px-4 py-3 tabular-nums text-zinc-300"><%= number_to_currency(subscription.monthly_price_cents / 100.0) %></td>
          <td class="px-4 py-3 capitalize text-zinc-400"><%= subscription.status %></td>
          <td class="px-4 py-3 text-zinc-400"><%= l(subscription.renewal_at, format: :short) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
