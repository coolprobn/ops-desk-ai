<% content_for :title, "Update password · Ops Desk" %>

<div class="rounded-lg border border-zinc-800 bg-zinc-900/60 p-8 shadow-xl shadow-black/40">
  <p class="text-xs font-medium uppercase tracking-wider text-zinc-500">Ops Desk</p>
  <h1 class="mt-2 text-2xl font-semibold text-zinc-50">Update your password</h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :password, "New password", class: "block text-sm text-zinc-300" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
            class: "mt-1 block w-full rounded-md border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-100 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "block text-sm text-zinc-300" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
            class: "mt-1 block w-full rounded-md border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-100 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500" %>
    </div>

    <%= form.submit "Save", class: "cursor-pointer rounded-md bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-950 hover:bg-white" %>
  <% end %>
</div>
